{
  "index_patterns": [
    "wazuh-threatintel-sigma-filters*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "auto_expand_replicas": "0-1",
        "codec": "zstd",
        "max_docvalue_fields_search": 100,
        "number_of_replicas": "0",
        "number_of_shards": "1"
      },
      "mapping.total_fields.limit": 1000
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "document": {
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "filter": {
              "properties": {
                "condition": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "rules": {
                  "ignore_above": 4096,
                  "type": "keyword"
                }
              }
            },
            "id": {
              "ignore_above": 4096,
              "type": "keyword"
            },
            "logsource": {
              "properties": {
                "category": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "definition": {
                  "norms": false,
                  "type": "text"
                },
                "product": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "service": {
                  "ignore_above": 4096,
                  "type": "keyword"
                }
              }
            },
            "metadata": {
              "properties": {
                "author": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "date": {
                  "type": "date"
                },
                "description": {
                  "norms": false,
                  "type": "text"
                },
                "documentation": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "modified": {
                  "type": "date"
                },
                "references": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "supports": {
                  "ignore_above": 4096,
                  "type": "keyword"
                },
                "title": {
                  "ignore_above": 4096,
                  "type": "keyword"
                }
              }
            },
            "name": {
              "ignore_above": 4096,
              "type": "keyword"
            }
          }
        },
        "hash": {
          "properties": {
            "sha256": {
              "ignore_above": 4096,
              "type": "keyword"
            }
          }
        },
        "offset": {
          "type": "unsigned_long"
        },
        "space": {
          "properties": {
            "name": {
              "ignore_above": 4096,
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
