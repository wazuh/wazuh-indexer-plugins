{
  "index_patterns": [
    "wazuh-agent-stats*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "mapping.total_fields.limit": 1000,
        "number_of_replicas": "0",
        "number_of_shards": "1",
        "query.default_field": [
          "wazuh.agent.id"
        ],
        "refresh_interval": "5s"
      }
    },
    "mappings": {
      "date_detection": false,
      "dynamic": "strict",
      "properties": {
        "message": {
          "ignore_above": 1024,
          "type": "keyword"
        },
        "state": {
          "properties": {
            "document_version": {
              "type": "integer"
            },
            "modified_at": {
              "type": "date"
            }
          }
        },
        "wazuh": {
          "properties": {
            "agent": {
              "properties": {
                "id": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "statistics": {
                  "properties": {
                    "agent": {
                      "properties": {
                        "last_keepalive": {
                          "type": "date"
                        },
                        "messages": {
                          "properties": {
                            "count": {
                              "type": "long"
                            }
                          }
                        },
                        "status": {
                          "ignore_above": 1024,
                          "type": "keyword"
                        },
                        "tasks": {
                          "properties": {
                            "discarded_duplicate": {
                              "properties": {
                                "total": {
                                  "type": "long"
                                }
                              }
                            },
                            "dispatched": {
                              "properties": {
                                "total": {
                                  "type": "long"
                                }
                              }
                            },
                            "failed": {
                              "properties": {
                                "total": {
                                  "type": "long"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "logcollector": {
                      "properties": {
                        "global": {
                          "properties": {
                            "end": {
                              "type": "date"
                            },
                            "files": {
                              "properties": {
                                "bytes": {
                                  "type": "long"
                                },
                                "events": {
                                  "type": "long"
                                },
                                "location": {
                                  "ignore_above": 1024,
                                  "type": "keyword"
                                },
                                "targets": {
                                  "properties": {
                                    "drops": {
                                      "type": "long"
                                    },
                                    "name": {
                                      "ignore_above": 1024,
                                      "type": "keyword"
                                    }
                                  }
                                }
                              }
                            },
                            "start": {
                              "type": "date"
                            }
                          }
                        },
                        "interval": {
                          "properties": {
                            "end": {
                              "type": "date"
                            },
                            "files": {
                              "properties": {
                                "bytes": {
                                  "type": "long"
                                },
                                "events": {
                                  "type": "long"
                                },
                                "location": {
                                  "ignore_above": 1024,
                                  "type": "keyword"
                                },
                                "targets": {
                                  "properties": {
                                    "drops": {
                                      "type": "long"
                                    },
                                    "name": {
                                      "ignore_above": 1024,
                                      "type": "keyword"
                                    }
                                  }
                                }
                              }
                            },
                            "start": {
                              "type": "date"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "cluster": {
              "properties": {
                "name": {
                  "ignore_above": 1024,
                  "type": "keyword"
                },
                "node": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            },
            "schema": {
              "properties": {
                "version": {
                  "ignore_above": 1024,
                  "type": "keyword"
                }
              }
            }
          }
        }
      }
    }
  }
}
