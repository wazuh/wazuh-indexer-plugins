{
  "index_patterns": [
    "wazuh-ai-assistant-sessions*"
  ],
  "priority": 1,
  "data_stream": {},
  "template": {
    "settings": {
      "index": {
        "auto_expand_replicas": "0-1",
        "codec": "zstd",
        "number_of_replicas": "0",
        "number_of_shards": "1",
        "query.default_field": [
          "title",
          "user"
        ],
        "refresh_interval": "1s"
      },
      "mapping.total_fields.limit": 1000,
      "plugins.index_state_management.policy_id": "ai-assistant-sessions-policy",
      "plugins.index_state_management.rollover_alias": "wazuh-ai-assistant-sessions"
    },
    "mappings": {
      "date_detection": false,
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "created_at": {
          "type": "date"
        },
        "messages": {
          "enabled": false,
          "type": "object"
        },
        "title": {
          "ignore_above": 1024,
          "type": "keyword"
        },
        "updated_at": {
          "type": "date"
        },
        "user": {
          "ignore_above": 1024,
          "type": "keyword"
        }
      }
    }
  }
}
