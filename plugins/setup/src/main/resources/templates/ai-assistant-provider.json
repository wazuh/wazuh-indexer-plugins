{
  "index_patterns": [
    ".wazuh-ai-assistant-provider*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "codec": "zstd",
        "hidden": true,
        "number_of_replicas": "0",
        "number_of_shards": "1",
        "refresh_interval": "1s"
      }
    },
    "mappings": {
      "date_detection": false,
      "dynamic": "strict",
      "properties": {
        "api_key": {
          "ignore_above": 1024,
          "type": "keyword"
        },
        "base_url": {
          "ignore_above": 1024,
          "type": "keyword"
        },
        "is_default": {
          "type": "boolean"
        },
        "model": {
          "ignore_above": 1024,
          "type": "keyword"
        },
        "name": {
          "ignore_above": 1024,
          "type": "keyword"
        },
        "type": {
          "ignore_above": 1024,
          "type": "keyword"
        }
      }
    }
  }
}
