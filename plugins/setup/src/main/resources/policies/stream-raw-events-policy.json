{
  "policy": {
    "policy_id": "stream-raw-events-policy",
    "description": "ISM policy for raw events data stream. Rolls over backing indices at 20 GB per primary shard (or 200,000,000 documents), then deletes each rolled-over index once it reaches 10 minutes of age. Effective retention is the greater of the two: the 10 minutes is a floor, not a ceiling, and deployments that never fill a shard retain raw events indefinitely.",
    "last_updated_time": 1772122150,
    "schema_version": 1,
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "rollover": {
              "min_doc_count": 200000000,
              "min_primary_shard_size": "20gb"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "10m"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          ".ds-wazuh-events-raw-v5-*",
          "wazuh-events-raw-v5*"
        ],
        "priority": 0
      }
    ]
  }
}
