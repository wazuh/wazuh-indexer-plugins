{
  "index_patterns": [
    "upgradable*"
  ],
  "priority": 1,
  "version": 50300,
  "data_stream": {},
  "template": {
    "settings": {
      "mapping.total_fields.limit": 100,
      "index": {
        "number_of_shards": "1",
        "codec": "zstd",
        "refresh_interval": "5s",
        "query.default_field": ["name", "message"]
      }
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "name": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        }
      },
      "_meta": {
        "schema_version": 50300,
        "compat_version": 50200
      }
    }
  }
}
