{
  "index_patterns": [
    "wazuh-metrics-agents*"
  ],
  "priority": 1,
  "data_stream": {},
  "template": {
    "settings": {
      "plugins.index_state_management.policy_id": "stream-metrics-policy",
      "index": {
        "codec": "zstd",
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "auto_expand_replicas": "0-1",
        "refresh_interval": "5s",
        "query.default_field": [
          "wazuh.agent.groups",
          "wazuh.agent.host.architecture",
          "wazuh.agent.host.os.name",
          "wazuh.agent.host.os.platform",
          "wazuh.agent.host.os.version",
          "wazuh.agent.id",
          "wazuh.agent.name",
          "wazuh.agent.status",
          "wazuh.agent.version",
          "wazuh.cluster.name",
          "wazuh.cluster.node",
          "wazuh.schema.version"
        ],
        "max_docvalue_fields_search": 100
      },
      "mapping.total_fields.limit": 1000
    }
  }
}
