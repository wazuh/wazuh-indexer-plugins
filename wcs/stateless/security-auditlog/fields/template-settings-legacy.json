{
  "index_patterns": [
    "security-auditlog*"
  ],
  "order": 1,
  "settings": {
    "plugins.index_state_management.policy_id": "security-auditlog-policy",
    "index": {
      "codec": "zstd",
      "number_of_shards": "1",
      "number_of_replicas": "0",
      "auto_expand_replicas": "0-1",
      "refresh_interval": "5s",
      "query.default_field": [
        "audit_category",
        "audit_request_effective_user",
        "audit_request_initiating_user",
        "audit_request_privilege",
        "audit_request_remote_address",
        "audit_rest_request_path",
        "audit_trace_indices",
        "audit_trace_resolved_indices",
        "audit_transport_action"
      ],
      "max_docvalue_fields_search": 100
    },
    "mapping.total_fields.limit": 1000
  }
}
