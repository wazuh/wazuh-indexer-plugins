{
  "index_patterns": [
    "wazuh-threatintel-enrichments*"
  ],
  "order": 1,
  "settings": {
    "plugins.index_state_management.rollover_alias": "wazuh-threatintel-enrichments",
    
    "mapping.nested_fields.limit": 50,
    "index": {
      "codec": "zstd",
      "number_of_shards": "1",
      "number_of_replicas": "0",
      "auto_expand_replicas": "0-1",
      "refresh_interval": "2s",
      "query.default_field": [
        "document.feed.name",
        "document.id",
        "document.name",
        "document.provider",
        "document.reference",
        "document.software.alias",
        "document.software.name",
        "document.software.type",
        "document.tags",
        "document.type"
      ],
      "max_docvalue_fields_search": 200
    }
  }
}
