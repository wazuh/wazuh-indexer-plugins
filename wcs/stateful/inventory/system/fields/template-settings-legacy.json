{
  "index_patterns": ["wazuh-states-inventory-system*"],
  "order": 1,
  "settings": {
    "index": {
      "codec": "zstd",
      "gc_deletes": "15s",
      "number_of_shards": "1",
      "number_of_replicas": "0",
      "auto_expand_replicas": "0-1",
      "refresh_interval": "2s",
      "query.default_field": [
        "checksum.hash.sha1",
        "host.architecture",
        "host.hostname",
        "host.os.build",
        "host.os.codename",
        "host.os.distribution.release",
        "host.os.full",
        "host.os.kernel.name",
        "host.os.kernel.release",
        "host.os.kernel.version",
        "host.os.major",
        "host.os.minor",
        "host.os.name",
        "host.os.patch",
        "host.os.platform",
        "host.os.type",
        "host.os.version",
        "message",
        "wazuh.agent.groups",
        "wazuh.agent.host.architecture",
        "wazuh.agent.host.hostname",
        "wazuh.agent.host.os.name",
        "wazuh.agent.host.os.platform",
        "wazuh.agent.host.os.type",
        "wazuh.agent.host.os.version",
        "wazuh.agent.id",
        "wazuh.agent.name",
        "wazuh.agent.version",
        "wazuh.cluster.name",
        "wazuh.cluster.node",
        "wazuh.schema.version"
      ]
    }
  }
}
