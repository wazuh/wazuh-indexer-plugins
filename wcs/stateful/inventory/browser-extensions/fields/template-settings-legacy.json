{
  "index_patterns": ["wazuh-states-inventory-browser-extensions*"],
  "order": 1,
  "settings": {
    "index": {
      "codec": "zstd",
      "gc_deletes": "15s",
      "number_of_shards": "1",
      "number_of_replicas": "0",
      "auto_expand_replicas": "0-1",
      "refresh_interval": "2s",
      "query.default_field": [
        "browser.name",
        "browser.profile.name",
        "browser.profile.path",
        "checksum.hash.sha1",
        "file.hash.sha256",
        "message",
        "package.build_version",
        "package.description",
        "package.id",
        "package.name",
        "package.path",
        "package.permissions",
        "package.reference",
        "package.type",
        "package.vendor",
        "package.version",
        "user.id",
        "wazuh.agent.groups",
        "wazuh.agent.host.architecture",
        "wazuh.agent.host.hostname",
        "wazuh.agent.host.os.name",
        "wazuh.agent.host.os.platform",
        "wazuh.agent.host.os.type",
        "wazuh.agent.host.os.version",
        "wazuh.agent.id",
        "wazuh.agent.name",
        "wazuh.agent.version",
        "wazuh.cluster.name",
        "wazuh.cluster.node",
        "wazuh.schema.version"
      ]
    }
  }
}
