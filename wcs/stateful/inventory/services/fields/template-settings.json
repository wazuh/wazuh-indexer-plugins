{
  "index_patterns": [
    "wazuh-states-inventory-services*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "codec": "zstd",
        "gc_deletes": "15s",
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "auto_expand_replicas": "0-1",
        "refresh_interval": "2s",
        "query.default_field": [
          "checksum.hash.sha1",
          "error.log.file.path",
          "file.path",
          "log.file.path",
          "message",
          "process.args",
          "process.executable",
          "process.group.name",
          "process.root_directory",
          "process.user.name",
          "process.working_directory",
          "service.address",
          "service.description",
          "service.enabled",
          "service.following",
          "service.id",
          "service.name",
          "service.object_path",
          "service.restart",
          "service.start_type",
          "service.starts.on_not_empty_directory",
          "service.starts.on_path_modified",
          "service.state",
          "service.sub_state",
          "service.target.address",
          "service.target.ephemeral_id",
          "service.target.type",
          "service.type",
          "wazuh.agent.groups",
          "wazuh.agent.host.architecture",
          "wazuh.agent.host.hostname",
          "wazuh.agent.host.os.name",
          "wazuh.agent.host.os.platform",
          "wazuh.agent.host.os.type",
          "wazuh.agent.host.os.version",
          "wazuh.agent.id",
          "wazuh.agent.name",
          "wazuh.agent.version",
          "wazuh.cluster.name",
          "wazuh.cluster.node",
          "wazuh.schema.version"
        ]
      }
    }
  }
}