{
  "index_patterns": [
    "wazuh-states-inventory-users*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "codec": "zstd",
        "gc_deletes": "15s",
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "auto_expand_replicas": "0-1",
        "refresh_interval": "2s",
        "query.default_field": [
          "checksum.hash.sha1",
          "login.tty",
          "login.type",
          "message",
          "user.full_name",
          "user.groups",
          "user.home",
          "user.id",
          "user.name",
          "user.password.hash_algorithm",
          "user.password.status",
          "user.roles",
          "user.shell",
          "user.type",
          "user.uuid",
          "wazuh.agent.groups",
          "wazuh.agent.host.architecture",
          "wazuh.agent.host.hostname",
          "wazuh.agent.host.os.name",
          "wazuh.agent.host.os.platform",
          "wazuh.agent.host.os.type",
          "wazuh.agent.host.os.version",
          "wazuh.agent.id",
          "wazuh.agent.name",
          "wazuh.agent.version",
          "wazuh.cluster.name",
          "wazuh.cluster.node",
          "wazuh.schema.version"
        ]
      }
    }
  }
}