{
  "index_patterns": [
    "wazuh-states-inventory-packages*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "codec": "zstd",
        "gc_deletes": "15s",
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "auto_expand_replicas": "0-1",
        "refresh_interval": "2s",
        "query.default_field": [
          "checksum.hash.sha1",
          "message",
          "package.architecture",
          "package.category",
          "package.description",
          "package.multiarch",
          "package.name",
          "package.path",
          "package.priority",
          "package.source",
          "package.type",
          "package.vendor",
          "package.version",
          "wazuh.agent.groups",
          "wazuh.agent.host.architecture",
          "wazuh.agent.host.hostname",
          "wazuh.agent.host.os.name",
          "wazuh.agent.host.os.platform",
          "wazuh.agent.host.os.type",
          "wazuh.agent.host.os.version",
          "wazuh.agent.id",
          "wazuh.agent.name",
          "wazuh.agent.version",
          "wazuh.cluster.name",
          "wazuh.cluster.node",
          "wazuh.schema.version"
        ]
      }
    }
  }
}