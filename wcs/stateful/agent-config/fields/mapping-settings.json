{
    "dynamic": "strict_allow_templates",
    "date_detection": false,
    "dynamic_templates": [
        {
            "agent_configuration_objects": {
                "match_mapping_type": "object",
                "path_match": "wazuh.agent.configuration.content.*",
                "mapping": {
                    "type": "object"
                }
            }
        },
        {
            "agent_configuration_booleans": {
                "match_mapping_type": "boolean",
                "path_match": "wazuh.agent.configuration.content.*",
                "mapping": {
                    "type": "boolean"
                }
            }
        },
        {
            "agent_configuration_longs": {
                "match_mapping_type": "long",
                "path_match": "wazuh.agent.configuration.content.*",
                "mapping": {
                    "type": "long"
                }
            }
        },
        {
            "agent_configuration_doubles": {
                "match_mapping_type": "double",
                "path_match": "wazuh.agent.configuration.content.*",
                "mapping": {
                    "type": "double"
                }
            }
        },
        {
            "agent_configuration_strings": {
                "match_mapping_type": "string",
                "path_match": "wazuh.agent.configuration.content.*",
                "mapping": {
                    "type": "keyword",
                    "ignore_above": 1024
                }
            }
        }
    ]
}
