{
  "index_patterns": ["wazuh-states-fim-registry-keys*"],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "codec": "zstd",
        "gc_deletes": "15s",
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "auto_expand_replicas": "0-1",
        "refresh_interval": "2s",
        "query.default_field": [
          "checksum.hash.sha1",
          "message",
          "registry.architecture",
          "registry.gid",
          "registry.group",
          "registry.hive",
          "registry.key",
          "registry.owner",
          "registry.path",
          "registry.permissions",
          "registry.uid",
          "wazuh.agent.groups",
          "wazuh.agent.host.architecture",
          "wazuh.agent.host.hostname",
          "wazuh.agent.host.os.name",
          "wazuh.agent.host.os.platform",
          "wazuh.agent.host.os.type",
          "wazuh.agent.host.os.version",
          "wazuh.agent.id",
          "wazuh.agent.name",
          "wazuh.agent.version",
          "wazuh.cluster.name",
          "wazuh.cluster.node",
          "wazuh.schema.version"
        ]
      }
    }
  }
}
