{
  "index_patterns": [
    "wazuh-states-sca*"
  ],
  "priority": 1,
  "template": {
    "settings": {
      "index": {
        "codec": "zstd",
        "gc_deletes": "15s",
        "number_of_shards": "1",
        "number_of_replicas": "0",
        "auto_expand_replicas": "0-1",
        "refresh_interval": "5s",
        "query.default_field": [
          "check.compliance.cmmc",
          "check.compliance.fedramp",
          "check.compliance.gdpr",
          "check.compliance.hipaa",
          "check.compliance.iso_27001",
          "check.compliance.nis2",
          "check.compliance.nist_800_171",
          "check.compliance.nist_800_53",
          "check.compliance.pci_dss",
          "check.compliance.tsc",
          "check.condition",
          "check.description",
          "check.id",
          "check.mitre.subtechnique.id",
          "check.mitre.subtechnique.name",
          "check.mitre.tactic.id",
          "check.mitre.tactic.name",
          "check.mitre.technique.id",
          "check.mitre.technique.name",
          "check.name",
          "check.rationale",
          "check.reason",
          "check.references",
          "check.remediation",
          "check.result",
          "check.rules",
          "checksum.hash.sha1",
          "message",
          "policy.description",
          "policy.file",
          "policy.id",
          "policy.name",
          "policy.references",
          "wazuh.agent.groups",
          "wazuh.agent.host.architecture",
          "wazuh.agent.host.hostname",
          "wazuh.agent.host.os.name",
          "wazuh.agent.host.os.platform",
          "wazuh.agent.host.os.type",
          "wazuh.agent.host.os.version",
          "wazuh.agent.id",
          "wazuh.agent.name",
          "wazuh.agent.version",
          "wazuh.cluster.name",
          "wazuh.cluster.node",
          "wazuh.schema.version"
        ]
      }
    }
  }
}
