# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=elastic

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=elastic

# Set the cluster name
CLUSTER_NAME=elastic

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9201

# Port to expose Kibana to the host
KIBANA_PORT=5602

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=2147483648

# Wazuh indexer version, the source of the integrations
WAZUH_INDEXER_VERSION=5.0.0-rc1

# Credentials of this development environment. They follow the password policy of
# the Wazuh images. Never use them anywhere else.
WAZUH_INDEXER_ADMIN_PASSWORD=Dev.Admin-Password-2026
WAZUH_INDEXER_KIBANASERVER_PASSWORD=Dev.Kibanaserver-Password-2026
WAZUH_INDEXER_MANAGER_PASSWORD=Dev.Manager-Password-2026

# Read-only user of the Wazuh indexer that Logstash exports the data with
WAZUH_EXPORT_USERNAME=wazuh-export
WAZUH_EXPORT_PASSWORD=Dev.Export-Password-2026

# Data streams or patterns to export, comma-separated. Findings embed the event that
# triggered them: exporting events too duplicates that information.
WAZUH_EXPORT_INDICES=wazuh-findings-v5-*,wazuh-events-v5-*

# Events generator: seconds between an event and its finding (the detectors run every 2 minutes
# by default, so findings are indexed up to that long after their event), and a custom data
# stream that also receives a share of the events, to test exporting it (add it to
# WAZUH_EXPORT_INDICES)
WAZUH_GENERATOR_FINDINGS_DELAY=150
WAZUH_CUSTOM_STREAM=wazuh-custom-test

# Time window that every run reads, how far behind the current time it ends, and cron
# schedule of the runs. The delay must cover the time findings take to be indexed after
# their event (see logstash/pipeline/wazuh-indexer-input.conf)
WAZUH_EXPORT_LOOKBACK=1m
WAZUH_EXPORT_DELAY=5m
WAZUH_EXPORT_SCHEDULE="* * * * *"

# Administrator of the destination OpenSearch cluster (the default of its security configuration)
OPENSEARCH_ADMIN_PASSWORD=admin

# OpenSearch user that Logstash writes with (appends to logs-wazuh.*-*)
OPENSEARCH_LOGSTASH_USERNAME=wazuh-logstash
OPENSEARCH_LOGSTASH_PASSWORD=Dev.Logstash-Password-2026

# Elasticsearch user that Logstash writes with (create_doc and auto_configure on logs-wazuh.*-*)
ELASTIC_LOGSTASH_USERNAME=wazuh-logstash
ELASTIC_LOGSTASH_PASSWORD=Dev.Logstash-Password-2026

# Wazuh certs generator version
WAZUH_CERTS_GENERATOR_VERSION=0.0.1

# OpenSearch destination cluster version
OS_VERSION=3.9.0

# Logstash version:
LOGSTASH_OSS_VERSION=8.19.23

# Splunk administrator password and HTTP Event Collector token (development only)
SPLUNK_PASSWORD=Password.1234
SPLUNK_HEC_TOKEN=abcd1234

# Splunk version:
SPLUNK_VERSION=10.6.0

# Version of Elastic products
STACK_VERSION=9.5.4

# Amazon Security Lake: data streams to export (findings only), the stand-in buckets and
# account of the development environment, and the minutes Logstash collects documents in a
# file before uploading it. The AWS credentials are those of the moto server: any value.
SECURITY_LAKE_EXPORT_INDICES=wazuh-findings-v5-*
S3_BUCKET_RAW=wazuh-findings-raw
S3_BUCKET_OCSF=wazuh-findings-ocsf
SECURITY_LAKE_BUCKET=aws-security-data-lake-us-east-1-example
SECURITY_LAKE_SOURCE_LOCATION=wazuh
SECURITY_LAKE_ACCOUNT_ID=111111111111
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=development
AWS_SECRET_ACCESS_KEY=development
S3_TIME_FILE=1
