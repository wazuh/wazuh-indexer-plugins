{
  "title": "Wazuh - Events overview",
  "description": "Normalized events exported from the Wazuh indexer.",
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "title": "Time range",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
  "dataSources": {
    "ds_01": {
      "type": "ds.search",
      "name": "Events",
      "options": {
        "query": "`wazuh_events` | stats count"
      }
    },
    "ds_02": {
      "type": "ds.search",
      "name": "Agents",
      "options": {
        "query": "`wazuh_events` | stats dc(wazuh.agent.name)"
      }
    },
    "ds_03": {
      "type": "ds.search",
      "name": "Integrations",
      "options": {
        "query": "`wazuh_events` | stats dc(wazuh.integration.name)"
      }
    },
    "ds_04": {
      "type": "ds.search",
      "name": "Failed outcomes",
      "options": {
        "query": "`wazuh_events` event.outcome=\"failure\" | stats count"
      }
    },
    "ds_05": {
      "type": "ds.search",
      "name": "Events over time by category",
      "options": {
        "query": "`wazuh_events` | timechart usenull=f useother=f count by wazuh.integration.category"
      }
    },
    "ds_06": {
      "type": "ds.search",
      "name": "Events by outcome",
      "options": {
        "query": "`wazuh_events` | eval outcome=coalesce('event.outcome', \"unknown\") | stats count by outcome"
      }
    },
    "ds_07": {
      "type": "ds.search",
      "name": "Top integrations",
      "options": {
        "query": "`wazuh_events` | stats count by wazuh.integration.name | sort - count | head 10"
      }
    },
    "ds_08": {
      "type": "ds.search",
      "name": "Top agents",
      "options": {
        "query": "`wazuh_events` | stats count by wazuh.agent.name | sort - count | head 10"
      }
    },
    "ds_09": {
      "type": "ds.search",
      "name": "Authentication failures by source",
      "options": {
        "query": "`wazuh_events` \"event.category{}\"=\"authentication\" event.outcome=\"failure\" | stats count, values(user.name) as users, dc(wazuh.agent.name) as agents by source.ip | sort - count | head 20"
      }
    },
    "ds_10": {
      "type": "ds.search",
      "name": "Cloud activity",
      "options": {
        "query": "`wazuh_events` wazuh.integration.category=\"cloud-services\" | stats count by cloud.provider, cloud.account.id, event.action, event.outcome | sort - count"
      }
    }
  },
  "visualizations": {
    "viz_01": {
      "type": "splunk.singlevalue",
      "title": "Events",
      "dataSources": {
        "primary": "ds_01"
      },
      "options": {}
    },
    "viz_02": {
      "type": "splunk.singlevalue",
      "title": "Agents",
      "dataSources": {
        "primary": "ds_02"
      },
      "options": {}
    },
    "viz_03": {
      "type": "splunk.singlevalue",
      "title": "Integrations",
      "dataSources": {
        "primary": "ds_03"
      },
      "options": {}
    },
    "viz_04": {
      "type": "splunk.singlevalue",
      "title": "Failed outcomes",
      "dataSources": {
        "primary": "ds_04"
      },
      "options": {}
    },
    "viz_05": {
      "type": "splunk.column",
      "title": "Events over time by category",
      "dataSources": {
        "primary": "ds_05"
      },
      "options": {
        "stackMode": "stacked",
        "w": 800
      }
    },
    "viz_06": {
      "type": "splunk.pie",
      "title": "Events by outcome",
      "dataSources": {
        "primary": "ds_06"
      },
      "options": {}
    },
    "viz_07": {
      "type": "splunk.bar",
      "title": "Top integrations",
      "dataSources": {
        "primary": "ds_07"
      },
      "options": {}
    },
    "viz_08": {
      "type": "splunk.bar",
      "title": "Top agents",
      "dataSources": {
        "primary": "ds_08"
      },
      "options": {}
    },
    "viz_09": {
      "type": "splunk.table",
      "title": "Authentication failures by source",
      "dataSources": {
        "primary": "ds_09"
      },
      "options": {}
    },
    "viz_10": {
      "type": "splunk.table",
      "title": "Cloud activity",
      "dataSources": {
        "primary": "ds_10"
      },
      "options": {}
    }
  },
