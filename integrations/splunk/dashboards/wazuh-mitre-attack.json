{
  "title": "Wazuh - MITRE ATT&CK",
  "description": "MITRE ATT&CK tactics and techniques of the rules that produced the findings.",
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "title": "Time range",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
  "dataSources": {
    "ds_01": {
      "type": "ds.search",
      "name": "Findings with MITRE ATT&CK",
      "options": {
        "query": "`wazuh_findings` \"wazuh.rule.mitre.technique.id{}\"=* | stats count"
      }
    },
    "ds_02": {
      "type": "ds.search",
      "name": "Tactics",
      "options": {
        "query": "`wazuh_findings` | stats dc(\"wazuh.rule.mitre.tactic.id{}\")"
      }
    },
    "ds_03": {
      "type": "ds.search",
      "name": "Techniques",
      "options": {
        "query": "`wazuh_findings` | stats dc(\"wazuh.rule.mitre.technique.id{}\")"
      }
    },
    "ds_04": {
      "type": "ds.search",
      "name": "Sub-techniques",
      "options": {
        "query": "`wazuh_findings` | stats dc(\"wazuh.rule.mitre.subtechnique.id{}\")"
      }
    },
    "ds_05": {
      "type": "ds.search",
      "name": "Tactics over time",
      "options": {
        "query": "`wazuh_findings` | rename \"wazuh.rule.mitre.tactic.name{}\" as tactic | timechart usenull=f useother=f count by tactic"
      }
    },
    "ds_06": {
      "type": "ds.search",
      "name": "Findings by tactic",
      "options": {
        "query": "`wazuh_findings` | rename \"wazuh.rule.mitre.tactic.name{}\" as tactic | stats count by tactic"
      }
    },
    "ds_07": {
      "type": "ds.search",
      "name": "Top techniques",
      "options": {
        "query": "`wazuh_findings` | rename \"wazuh.rule.mitre.technique.name{}\" as technique | stats count by technique | sort - count | head 10"
      }
    },
    "ds_08": {
      "type": "ds.search",
      "name": "Top sub-techniques",
      "options": {
        "query": "`wazuh_findings` | rename \"wazuh.rule.mitre.subtechnique.name{}\" as subtechnique | where isnotnull(subtechnique) | stats count by subtechnique | sort - count | head 10"
      }
    },
    "ds_09": {
      "type": "ds.search",
      "name": "Techniques",
      "options": {
        "query": "`wazuh_findings` | rename \"wazuh.rule.mitre.technique.id{}\" as id, \"wazuh.rule.mitre.technique.name{}\" as technique, \"wazuh.rule.mitre.tactic.name{}\" as tactic | where isnotnull(id) | stats count, values(tactic) as tactics, dc(wazuh.agent.name) as agents, values(wazuh.rule.title) as rules by id, technique | sort - count"
      }
    }
  },
  "visualizations": {
    "viz_01": {
      "type": "splunk.singlevalue",
      "title": "Findings with MITRE ATT&CK",
      "dataSources": {
        "primary": "ds_01"
      },
      "options": {}
    },
    "viz_02": {
      "type": "splunk.singlevalue",
      "title": "Tactics",
      "dataSources": {
        "primary": "ds_02"
      },
      "options": {}
    },
    "viz_03": {
      "type": "splunk.singlevalue",
      "title": "Techniques",
      "dataSources": {
        "primary": "ds_03"
      },
      "options": {}
    },
    "viz_04": {
      "type": "splunk.singlevalue",
      "title": "Sub-techniques",
      "dataSources": {
        "primary": "ds_04"
      },
      "options": {}
    },
    "viz_05": {
      "type": "splunk.column",
      "title": "Tactics over time",
      "dataSources": {
        "primary": "ds_05"
      },
      "options": {
        "stackMode": "stacked",
        "w": 800
      }
    },
    "viz_06": {
      "type": "splunk.pie",
      "title": "Findings by tactic",
      "dataSources": {
        "primary": "ds_06"
      },
      "options": {}
    },
    "viz_07": {
      "type": "splunk.bar",
      "title": "Top techniques",
      "dataSources": {
        "primary": "ds_07"
      },
      "options": {}
    },
    "viz_08": {
      "type": "splunk.bar",
      "title": "Top sub-techniques",
      "dataSources": {
        "primary": "ds_08"
      },
      "options": {}
    },
    "viz_09": {
      "type": "splunk.table",
      "title": "Techniques",
      "dataSources": {
        "primary": "ds_09"
      },
      "options": {}
    }
  },
