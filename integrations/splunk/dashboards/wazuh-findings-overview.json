{
  "title": "Wazuh - Findings overview",
  "description": "Detection findings exported from the Wazuh indexer.",
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "title": "Time range",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
  "dataSources": {
    "ds_01": {
      "type": "ds.search",
      "name": "Findings",
      "options": {
        "query": "`wazuh_findings` | stats count"
      }
    },
    "ds_02": {
      "type": "ds.search",
      "name": "Critical and high",
      "options": {
        "query": "`wazuh_findings` (wazuh.rule.level=\"critical\" OR wazuh.rule.level=\"high\") | stats count"
      }
    },
    "ds_03": {
      "type": "ds.search",
      "name": "Agents with findings",
      "options": {
        "query": "`wazuh_findings` | stats dc(wazuh.agent.name)"
      }
    },
    "ds_04": {
      "type": "ds.search",
      "name": "Rules triggered",
      "options": {
        "query": "`wazuh_findings` | stats dc(wazuh.rule.id)"
      }
    },
    "ds_05": {
      "type": "ds.search",
      "name": "Findings over time by level",
      "options": {
        "query": "`wazuh_findings` | timechart usenull=f useother=f count by wazuh.rule.level"
      }
    },
    "ds_06": {
      "type": "ds.search",
      "name": "Findings by level",
      "options": {
        "query": "`wazuh_findings` | stats count by wazuh.rule.level"
      }
    },
    "ds_07": {
      "type": "ds.search",
      "name": "Findings by category",
      "options": {
        "query": "`wazuh_findings` | stats count by wazuh.integration.category | sort - count"
      }
    },
    "ds_08": {
      "type": "ds.search",
      "name": "Top agents",
      "options": {
        "query": "`wazuh_findings` | stats count by wazuh.agent.name | sort - count | head 10"
      }
    },
    "ds_09": {
      "type": "ds.search",
      "name": "Top rules",
      "options": {
        "query": "`wazuh_findings` | stats count, dc(wazuh.agent.name) as agents by wazuh.rule.title, wazuh.rule.level | eval level_order=case('wazuh.rule.level'=\"critical\",1,'wazuh.rule.level'=\"high\",2,'wazuh.rule.level'=\"medium\",3,'wazuh.rule.level'=\"low\",4,true(),5) | sort level_order, - count | fields - level_order | head 20"
      }
    },
    "ds_10": {
      "type": "ds.search",
      "name": "Latest findings",
      "options": {
        "query": "`wazuh_findings` | sort - _time | table _time, wazuh.agent.name, wazuh.rule.level, wazuh.rule.title, wazuh.integration.name, source.ip, user.name | head 50"
      }
    }
  },
  "visualizations": {
    "viz_01": {
      "type": "splunk.singlevalue",
      "title": "Findings",
      "dataSources": {
        "primary": "ds_01"
      },
      "options": {}
    },
    "viz_02": {
      "type": "splunk.singlevalue",
      "title": "Critical and high",
      "dataSources": {
        "primary": "ds_02"
      },
      "options": {}
    },
    "viz_03": {
      "type": "splunk.singlevalue",
      "title": "Agents with findings",
      "dataSources": {
        "primary": "ds_03"
      },
      "options": {}
    },
    "viz_04": {
      "type": "splunk.singlevalue",
      "title": "Rules triggered",
      "dataSources": {
        "primary": "ds_04"
      },
      "options": {}
    },
    "viz_05": {
      "type": "splunk.column",
      "title": "Findings over time by level",
      "dataSources": {
        "primary": "ds_05"
      },
      "options": {
        "stackMode": "stacked",
        "w": 800
      }
    },
    "viz_06": {
      "type": "splunk.pie",
      "title": "Findings by level",
      "dataSources": {
        "primary": "ds_06"
      },
      "options": {}
    },
    "viz_07": {
      "type": "splunk.bar",
      "title": "Findings by category",
      "dataSources": {
        "primary": "ds_07"
      },
      "options": {}
    },
    "viz_08": {
      "type": "splunk.bar",
      "title": "Top agents",
      "dataSources": {
        "primary": "ds_08"
      },
      "options": {}
    },
    "viz_09": {
      "type": "splunk.table",
      "title": "Top rules",
      "dataSources": {
        "primary": "ds_09"
      },
      "options": {}
    },
    "viz_10": {
      "type": "splunk.table",
      "title": "Latest findings",
      "dataSources": {
        "primary": "ds_10"
      },
      "options": {}
    }
  },
